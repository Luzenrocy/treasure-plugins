{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "dist-node",
    "rootDir": "src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/index.ts",
    "src/handler.ts",
    "src/security.ts",
    "src/supabase.ts",
    "src/db/**/*.ts"
  ],
  "exclude": [
    "dist",
    "dist-node",
    "node_modules"
  ]
}
