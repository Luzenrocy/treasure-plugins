# 前端通过同源 /api 访问应用
VITE_API_BASE_URL=/api

# Node 应用环境（index.ts 通过 Supabase REST / PostgREST 访问数据库）
PORT=7860
VITE_SUPABASE_URL=https://wwawwqaegqxtqmqblxef.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=XXXXX
AUTH_JWT_SECRET=change-this-secret-to-at-least-32-characters
# 可选：密钥轮换期旧密钥（逗号分隔，仅用于校验、不用于签发）。
# 托管平台滚动更新/多实例场景下签发与校验可能落在不同密钥的实例上，
# 把旧密钥填在这里可避免"刚登录就提示已过期"。
# AUTH_JWT_PREVIOUS_SECRETS=old-secret-1,old-secret-2
