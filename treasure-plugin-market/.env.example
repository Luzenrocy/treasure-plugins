# 前端通过同源 /api 访问应用
VITE_API_BASE_URL=/api

# Node 应用环境：仅可二选一：supabase（默认）或 mysql。
# 选 mysql 时不需要任何 SUPABASE_* 变量；选 supabase 时不需要 MYSQL_URL。
DATABASE_PROVIDER=supabase
PORT=7860
# MySQL 8+：DATABASE_PROVIDER=mysql 时必填（URL 中的密码需要 URL 编码）
# MYSQL_URL=mysql://treasure:change-me@127.0.0.1:3306/treasure_plugin_market

# Supabase：DATABASE_PROVIDER=supabase 时必填
VITE_SUPABASE_URL=https://wwawwqaegqxtqmqblxef.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=XXXXX
# 会话存储认证（auth_sessions 表）专用：service-role 密钥，全库全权。
# 仅存服务端环境变量/FC Secret，绝不进入前端 bundle 或仓库；未配置时登录/会话接口不可用。
SUPABASE_SERVICE_ROLE_KEY=XXXXX
AUTH_JWT_SECRET=change-this-secret-to-at-least-32-characters
# 可选：密钥轮换期旧密钥（逗号分隔，仅用于校验、不用于签发）。
# 托管平台滚动更新/多实例场景下签发与校验可能落在不同密钥的实例上，
# 把旧密钥填在这里可避免"刚登录就提示已过期"。
# AUTH_JWT_PREVIOUS_SECRETS=old-secret-1,old-secret-2
